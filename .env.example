# =============================================================================
# .env.example — copy to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)
# =============================================================================

# PostgreSQL
POSTGRES_DB=ecom_platform
POSTGRES_USER=ecom
POSTGRES_PASSWORD=changeme

# Application JWT secret — minimum 32 characters for HMAC-SHA256
JWT_SECRET=dev-secret-key-must-be-at-least-32-bytes-long-for-hmac-sha256!

# Grafana admin credentials (local development only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin